# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# firebase service account keys
*firebase-adminsdk*.json

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# agents & vscode metadata
.agents/
.vscode/

# 캐릭터 일러스트 생성 원본(후보). 최종본만 public/character/로 옮겨 커밋한다
assets/character/generated/

# 도서 원본(인쇄용 PDF·표지 원본)은 커밋하지 않는다. 변환 결과만 content/·public/에 둔다
/*.pdf
/cover(*
/cover_*
