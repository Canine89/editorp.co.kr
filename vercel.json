{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/_next/image",
      "has": [{ "type": "query", "key": "url", "value": "/(?<imageRoot>covers|character|learning|selected-books|icons|og)/(?<imageName>[A-Za-z0-9_.-]+\\.(?:png|jpg|jpeg|webp|avif|svg))" }],
      "destination": "/:imageRoot/:imageName",
      "permanent": false
    },
    {
      "source": "/_next/image",
      "has": [{ "type": "query", "key": "url", "value": "/(?<imageRoot>books|articles)/(?<imageDir>[a-z0-9-]+)/(?<imageName>[A-Za-z0-9_.-]+\\.(?:png|jpg|jpeg|webp|avif|svg))" }],
      "destination": "/:imageRoot/:imageDir/:imageName",
      "permanent": false
    },
    {
      "source": "/_next/image",
      "has": [{ "type": "query", "key": "url", "value": "/(?<imageRoot>books|articles)/(?<imageDir>[a-z0-9-]+)/responsive/(?<imageName>[A-Za-z0-9_.-]+\\.webp)" }],
      "destination": "/:imageRoot/:imageDir/responsive/:imageName",
      "permanent": false
    },
    {
      "source": "/_next/image",
      "has": [{ "type": "query", "key": "url", "value": "/(?<imagePath>(?:cursor-ambassador|hero|p|icon)\\.png)" }],
      "destination": "/:imagePath",
      "permanent": false
    },
    {
      "source": "/_next/image",
      "has": [{ "type": "query", "key": "url", "value": "https://i\\.ytimg\\.com/vi/(?<videoId>[A-Za-z0-9_-]+)/(?<imageName>[A-Za-z0-9_-]+\\.(?:jpg|webp))" }],
      "destination": "https://i.ytimg.com/vi/:videoId/:imageName",
      "permanent": false
    },
    {
      "source": "/_next/image",
      "has": [{ "type": "query", "key": "url", "value": "https://image\\.yes24\\.com/goods/(?<goodsId>[0-9]+)/(?<imageSize>XL|L|M|S)" }],
      "destination": "https://image.yes24.com/goods/:goodsId/:imageSize",
      "permanent": false
    },
    {
      "source": "/_next/image",
      "destination": "/file.svg",
      "permanent": false
    }
  ]
}
